{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "python_version": {
            "title": "Python Version",
            "type": "string"
          },
          "service": {
            "default": "research-trail",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "python_version"
        ],
        "title": "Health",
        "type": "object"
      },
      "Kline": {
        "additionalProperties": false,
        "properties": {
          "close": {
            "exclusiveMinimum": 0,
            "title": "Close",
            "type": "number"
          },
          "high": {
            "exclusiveMinimum": 0,
            "title": "High",
            "type": "number"
          },
          "low": {
            "exclusiveMinimum": 0,
            "title": "Low",
            "type": "number"
          },
          "open": {
            "exclusiveMinimum": 0,
            "title": "Open",
            "type": "number"
          },
          "timestamp": {
            "description": "UTC Unix seconds, never milliseconds",
            "exclusiveMinimum": 0,
            "title": "Timestamp",
            "type": "integer"
          },
          "volume": {
            "minimum": 0,
            "title": "Volume",
            "type": "integer"
          }
        },
        "required": [
          "timestamp",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "Kline",
        "type": "object"
      },
      "MarketError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "UNKNOWN_SYMBOL",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "symbol"
        ],
        "title": "MarketError",
        "type": "object"
      },
      "MarketSnapshot": {
        "additionalProperties": false,
        "properties": {
          "data_label": {
            "const": "模拟数据",
            "default": "模拟数据",
            "title": "Data Label",
            "type": "string"
          },
          "fetched_at": {
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "fixture_version": {
            "const": "authored-v1",
            "default": "authored-v1",
            "title": "Fixture Version",
            "type": "string"
          },
          "klines": {
            "items": {
              "$ref": "#/components/schemas/Kline"
            },
            "minItems": 2,
            "title": "Klines",
            "type": "array"
          },
          "market_time": {
            "format": "date-time",
            "title": "Market Time",
            "type": "string"
          },
          "period": {
            "const": "1d",
            "default": "1d",
            "title": "Period",
            "type": "string"
          },
          "quote": {
            "$ref": "#/components/schemas/Quote"
          },
          "source": {
            "const": "fixture",
            "default": "fixture",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "market_time",
          "fetched_at",
          "quote",
          "klines"
        ],
        "title": "MarketSnapshot",
        "type": "object"
      },
      "MarketSymbol": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "name"
        ],
        "title": "MarketSymbol",
        "type": "object"
      },
      "Quote": {
        "additionalProperties": false,
        "properties": {
          "change": {
            "title": "Change",
            "type": "number"
          },
          "change_percent": {
            "title": "Change Percent",
            "type": "number"
          },
          "currency": {
            "const": "USD",
            "default": "USD",
            "title": "Currency",
            "type": "string"
          },
          "high": {
            "exclusiveMinimum": 0,
            "title": "High",
            "type": "number"
          },
          "last_price": {
            "exclusiveMinimum": 0,
            "title": "Last Price",
            "type": "number"
          },
          "low": {
            "exclusiveMinimum": 0,
            "title": "Low",
            "type": "number"
          },
          "market_time": {
            "format": "date-time",
            "title": "Market Time",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "open": {
            "exclusiveMinimum": 0,
            "title": "Open",
            "type": "number"
          },
          "previous_close": {
            "exclusiveMinimum": 0,
            "title": "Previous Close",
            "type": "number"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "volume": {
            "minimum": 0,
            "title": "Volume",
            "type": "integer"
          }
        },
        "required": [
          "symbol",
          "name",
          "last_price",
          "previous_close",
          "change",
          "change_percent",
          "open",
          "high",
          "low",
          "volume",
          "market_time"
        ],
        "title": "Quote",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-researchtrail-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Researchtrail-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Health"
      }
    },
    "/market/snapshot/{symbol}": {
      "get": {
        "operationId": "snapshot_market_snapshot__symbol__get",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "title": "Symbol",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-researchtrail-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Researchtrail-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Snapshot"
      }
    },
    "/market/symbols": {
      "get": {
        "operationId": "symbols_market_symbols_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-researchtrail-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Researchtrail-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MarketSymbol"
                  },
                  "title": "Response Symbols Market Symbols Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Symbols"
      }
    }
  }
}
