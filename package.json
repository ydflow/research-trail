{
  "name": "research-trail",
  "private": true,
  "trustedDependencies": ["electron", "esbuild"],
  "workspaces": ["apps/desktop"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs && bun run --cwd apps/desktop build",
    "check": "bun run --cwd apps/desktop check",
    "test:desktop": "node --test tests/desktop.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
