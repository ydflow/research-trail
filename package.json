{
  "name": "research-trail",
  "private": true,
  "packageManager": "bun@1.4.2",
  "trustedDependencies": ["electron", "esbuild"],
  "workspaces": ["apps/desktop"],
  "scripts": {
    "dev": "node scripts/contracts.mjs && node scripts/dev.mjs",
    "build": "node scripts/build.mjs && bun run --cwd apps/desktop build",
    "check": "node scripts/contracts.mjs --check && bun run --cwd apps/desktop check",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "test:desktop": "node --test tests/desktop.test.cjs",
    "test:stream": "node --test tests/stream.test.cjs",
    "verify": "node scripts/verify.mjs",
    "verify:clean": "node scripts/verify-clean.mjs",
    "prepare:desktop": "node scripts/prepare-electron.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
